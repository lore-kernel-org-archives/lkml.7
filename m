> --- a/include/linux/memory.h
> +++ b/include/linux/memory.h
> @@ -29,8 +29,6 @@ struct memory_block {
>  	int section_count;		/* serialized by mem_sysfs_mutex */
>  	int online_type;		/* for passing data to online routine */
