   116				*val = val64;
   117				*val2 = 100 << (CROS_EC_SENSOR_BITS - 1);
   118				ret = IIO_VAL_FRACTIONAL;
   119				break;
   120			default:
   121				ret = -EINVAL;
   122			}
   123			break;
